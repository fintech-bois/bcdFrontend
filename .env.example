# ====================================
# Blockchain RMT Project - Environment Variables Template
# ====================================
# Copy this file to .env.local and fill in your actual values
# cp .env.example .env.local

# ====================================
# STRIPE CONFIGURATION
# ====================================
# Get your keys from: https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_... and sk_test_...) for development
# Use live keys (pk_live_... and sk_live_...) for production

NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Get this from Stripe CLI in development: stripe listen --forward-to localhost:3000/api/webhook
# Get this from Stripe Dashboard → Webhooks in production
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ====================================
# SMART CONTRACT CONFIGURATION
# ====================================
# Deploy smart contracts from bcdContract repository first!
# Steps:
# 1. cd ../bcdContract
# 2. npx hardhat node (keep running in separate terminal)
# 3. npm run deploy (in another terminal)
# 4. Copy the contract address and paste below

# These are Hardhat's default development values shown below for reference
# Replace with actual values from your Hardhat node output
NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_OWNER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# ⚠️ IMPORTANT: These default keys are for local development ONLY
# Never use them in production or with real funds!

# For local development, use Hardhat node
RPC_URL=http://127.0.0.1:8545

# For production, use a provider like Infura, Alchemy, or QuickNode
# RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
# or
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ====================================
# PAYPAL CONFIGURATION
# ====================================
# Get from: https://developer.paypal.com/dashboard/applications
# You need a PayPal Business Account
# Create a REST API app with Payouts enabled

PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# ====================================
# DATABASE CONFIGURATION
# ====================================
# Local development with WAMP
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=bcd

# Production example (use your managed database service)
# DATABASE_HOST=your-database-host.amazonaws.com
# DATABASE_USER=bcduser
# DATABASE_PASSWORD=your_secure_password
# DATABASE_NAME=bcd

# ====================================
# APPLICATION CONFIGURATION
# ====================================
NODE_ENV=development

# Generate a secure random string for JWT secret
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_random_jwt_secret_key_at_least_32_characters_long

# ====================================
# EMAIL SERVICE (RESEND)
# ====================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# ====================================
# WEB3 WALLET CONNECTION (REOWN/WALLETCONNECT)
# ====================================
# Get your project ID from: https://cloud.reown.com
NEXT_PUBLIC_PROJECT_ID=your_reown_project_id_here

# ====================================
# NOTES
# ====================================
# - Never commit .env.local to version control
# - Use test/sandbox keys for development
# - Use production keys only in production environment
# - Keep your private keys secure and never share them
# - For production, use environment variables in your hosting platform
#   (Vercel, Netlify, etc.) instead of .env.local file
